{
  "name": "querio-plus",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "GraphQL & HTTP request inspector for Chrome DevTools (an original reimplementation informed by Querio).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/smoke-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "graphql": "16.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
