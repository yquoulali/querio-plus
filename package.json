{
  "name": "querio-plus",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "A Chrome DevTools extension for inspecting GraphQL and HTTP requests. Features filtering, search, JSON tree view, request comparison, and session export.",
  "author": "Younes Qoualali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yquoulali/querio-plus.git"
  },
  "bugs": {
    "url": "https://github.com/yquoulali/querio-plus/issues"
  },
  "keywords": [
    "chrome-extension",
    "devtools",
    "graphql",
    "network",
    "inspector",
    "debugging"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/smoke-check.mjs",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "graphql": "16.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
